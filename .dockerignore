# Local/editor artifacts
.DS_Store
.Rhistory
.Rproj.user/
.claude/
.codex_backups/
.qodo/
*.Rproj

# Git metadata
.git/
.gitignore

# Secrets — never bake into the image
.env
.env.local

# Documentation and repository metadata (not needed at runtime)
docs/
README.md
CITATION.cff
.zenodo.json
LICENSE
desktop/
.github/

# Private review and manuscript materials must never enter an image context
paper/
examples/manuscript-cases/
scripts/validate_reviewer_package.py

# Runtime/generated artifacts
cache/
build_sources/
data/
ncbi_downloads/
_incoming_brachypodium/
outputs/
logs/
tmp/

# Large biological datasets are mounted as volumes in docker-compose.
# Remove these lines only if you want a very large self-contained image.
annotations/
genomes/
go_annotations/

# Keep compressed screencasts in the runtime image; exclude source backups.
www/screencasts.orig/
www/ctv_backup/

# Always regenerate runtime bytecode inside the image.
.cgv-compiled/
